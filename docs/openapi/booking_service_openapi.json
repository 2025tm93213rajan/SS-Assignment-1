{
  "openapi": "3.1.0",
  "info": {
    "title": "SeatLock Booking & Saga Orchestration Service",
    "description": "Distributed Saga Orchestrator managing multi-phase ticket reservation transactions with automated compensating rollbacks (BR4).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Observability"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings": {
      "post": {
        "tags": [
          "Saga Orchestration"
        ],
        "summary": "Create Booking",
        "description": "Executes the distributed reservation Saga:\n1. Holds inventory in inventory_db (BR1, BR2)\n2. Executes idempotent card charge in payment_db (BR3)\n   - If payment fails, triggers compensation: releases held inventory (BR4)\n3. Issues official PNR and berths in ticketing_db\n4. Publishes booking.confirmed AMQP event to RabbitMQ\n5. Confirms booking",
        "operationId": "create_booking_api_v1_bookings_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Saga Orchestration"
        ],
        "summary": "List Bookings",
        "operationId": "list_bookings_api_v1_bookings_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingResponse"
                  },
                  "title": "Response List Bookings Api V1 Bookings Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings/{booking_id}": {
      "get": {
        "tags": [
          "Saga Orchestration"
        ],
        "summary": "Get Booking By Id",
        "operationId": "get_booking_by_id_api_v1_bookings__booking_id__get",
        "parameters": [
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Booking Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings/{booking_id}/cancel": {
      "post": {
        "tags": [
          "Saga Orchestration"
        ],
        "summary": "Cancel Booking",
        "operationId": "cancel_booking_api_v1_bookings__booking_id__cancel_post",
        "parameters": [
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Booking Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelBookingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bookings/reset": {
      "post": {
        "tags": [
          "Testing & Benchmarking"
        ],
        "summary": "Reset Bookings",
        "operationId": "reset_bookings_api_v1_bookings_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingResponse": {
        "properties": {
          "booking_id": {
            "type": "string",
            "title": "Booking Id"
          },
          "quota_id": {
            "type": "string",
            "title": "Quota Id"
          },
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "passenger_count": {
            "type": "integer",
            "title": "Passenger Count"
          },
          "total_amount": {
            "type": "number",
            "title": "Total Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "reservation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reservation Id"
          },
          "payment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Id"
          },
          "pnr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pnr"
          },
          "customer_name": {
            "type": "string",
            "title": "Customer Name"
          },
          "customer_email": {
            "type": "string",
            "title": "Customer Email"
          },
          "customer_phone": {
            "type": "string",
            "title": "Customer Phone"
          },
          "compensation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compensation Reason"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/SagaStepDetail"
            },
            "type": "array",
            "title": "Steps",
            "default": []
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "booking_id",
          "quota_id",
          "event_name",
          "category",
          "passenger_count",
          "total_amount",
          "status",
          "customer_name",
          "customer_email",
          "customer_phone",
          "created_at"
        ],
        "title": "BookingResponse"
      },
      "CancelBookingResponse": {
        "properties": {
          "booking_id": {
            "type": "string",
            "title": "Booking Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "compensation_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Compensation Steps"
          }
        },
        "type": "object",
        "required": [
          "booking_id",
          "status",
          "message",
          "compensation_steps"
        ],
        "title": "CancelBookingResponse"
      },
      "CreateBookingRequest": {
        "properties": {
          "quota_id": {
            "type": "string",
            "title": "Quota Id",
            "description": "Target inventory quota identifier"
          },
          "event_name": {
            "type": "string",
            "title": "Event Name",
            "description": "Train number, concert tour, or bus route name"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "Booking domain category",
            "default": "RAILWAY_TATKAL"
          },
          "passengers": {
            "items": {
              "$ref": "#/components/schemas/PassengerInfo"
            },
            "type": "array",
            "minItems": 1,
            "title": "Passengers",
            "description": "List of passengers"
          },
          "total_amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Total Amount",
            "description": "Total reservation price in INR"
          },
          "customer_name": {
            "type": "string",
            "minLength": 1,
            "title": "Customer Name"
          },
          "customer_email": {
            "type": "string",
            "minLength": 3,
            "title": "Customer Email"
          },
          "customer_phone": {
            "type": "string",
            "minLength": 8,
            "title": "Customer Phone"
          },
          "payment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PaymentInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key",
            "description": "Optional client idempotency key"
          }
        },
        "type": "object",
        "required": [
          "quota_id",
          "event_name",
          "passengers",
          "total_amount",
          "customer_name",
          "customer_email",
          "customer_phone"
        ],
        "title": "CreateBookingRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PassengerInfo": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name",
            "description": "Full passenger name"
          },
          "berth_preference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Berth Preference",
            "description": "Berth/Seat preference (LOWER, MIDDLE, UPPER, VIP)",
            "default": "LOWER"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PassengerInfo"
      },
      "PaymentInfo": {
        "properties": {
          "payment_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method",
            "description": "Payment instrument",
            "default": "CARD"
          },
          "card_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Number",
            "description": "Test card number (ends in 0002 to simulate decline)",
            "default": "4000-0000-0000-0001"
          },
          "force_failure": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Force Failure",
            "description": "Simulate payment gateway failure for saga rollback",
            "default": false
          },
          "delay_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Ms",
            "description": "Injected chaos latency",
            "default": 0
          }
        },
        "type": "object",
        "title": "PaymentInfo"
      },
      "SagaStepDetail": {
        "properties": {
          "step_name": {
            "type": "string",
            "title": "Step Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "step_name",
          "status",
          "timestamp"
        ],
        "title": "SagaStepDetail"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}